# Copie para .env (nunca versione o .env)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de administrador (Project Settings > API Keys > secret / service_role).
# Fica SOMENTE no servidor. Nunca coloque no app Android.
SUPABASE_SERVICE_KEY=troque-por-sua-chave-secret

# Opcional: só para projetos antigos que assinam o token com HS256 (JWT Secret).
# Projetos novos usam ES256 e não precisam disto.
SUPABASE_JWT_SECRET=

# Janela (em dias) para avisar feriados próximos nas notificações
DIAS_AVISO_FERIADO=14

# Dados institucionais usados para preencher os documentos:
EMPRESA_RAZAO_SOCIAL=
EMPRESA_NOME_FANTASIA=
EMPRESA_CNPJ=
EMPRESA_ENDERECO=
EMPRESA_EMAIL=
EMPRESA_REPRESENTANTE_NOME=
EMPRESA_REPRESENTANTE_CPF=
EMPRESA_CIDADE_UF=
PROCESSO_SELETIVO_ANO=2026
SUPABASE_MEMBER_DOCUMENTS_BUCKET=member-documents

# O termo de adesão anexado tem o campo [data de encerramento] na cláusula 5ª.
# Por isso, a API exige que a data seja informada ao gerar o termo.
APP_TIMEZONE=America/Maceio
