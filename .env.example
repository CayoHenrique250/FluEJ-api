# Copie para .env (nunca versione o .env)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave de administrador (Project Settings > API Keys > secret / service_role).
# Fica SOMENTE no servidor. Nunca coloque no app Android.
SUPABASE_SERVICE_KEY=troque-por-sua-chave-secret

# Opcional: só para projetos antigos que assinam o token com HS256 (JWT Secret).
# Projetos novos usam ES256 e não precisam disto.
SUPABASE_JWT_SECRET=

# Janela (em dias) para avisar feriados próximos nas notificações
DIAS_AVISO_FERIADO=14
